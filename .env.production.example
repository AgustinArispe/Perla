# Copiar a .env (ignorado por Git); no compartir ni guardar la clave en el repositorio.
BOCHA_DOMAIN=pos.tudominio.com
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOCHA_BACKUP_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CARACTERES_HEXADECIMALES
# Ajustables según la operación; no ampliar fuera de los límites validados por la API.
BOCHA_SESSION_IDLE_MINUTES=30
BOCHA_SESSION_MAX_HOURS=8
# Copia automática semanal, sábados; retención de copias de esta programación.
BOCHA_AUTO_BACKUP_ENABLED=true
BOCHA_AUTO_BACKUP_RETENTION=2
BOCHA_AUTO_BACKUP_TIMEZONE=America/Argentina/Buenos_Aires
