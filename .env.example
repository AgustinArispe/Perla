BOCHA_PUBLIC_ORIGIN=http://localhost:5173
# Generar una clave aleatoria de 32 bytes en hexadecimal para desarrollo.
BOCHA_BACKUP_KEY=
# Cierra la sesión luego de este tiempo sin actividad. Producción: 5 a 240 minutos.
BOCHA_SESSION_IDLE_MINUTES=30
# Duración máxima de una sesión, aunque siga activa. Producción: 1 a 24 horas.
BOCHA_SESSION_MAX_HOURS=8
# Copia automática los sábados; false la desactiva sin borrar copias existentes.
BOCHA_AUTO_BACKUP_ENABLED=true
BOCHA_AUTO_BACKUP_RETENTION=2
BOCHA_AUTO_BACKUP_TIMEZONE=America/Argentina/Buenos_Aires
